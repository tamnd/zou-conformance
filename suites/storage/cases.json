      "feature": "bucket.empty",
      "method": "POST",
      "path": "/storage/v1/bucket/photos/empty",
      "key": "service",
      "writes": true
    },
    {
      "name": "emptying a bucket that is already empty",
      "feature": "bucket.empty",
      "method": "POST",
      "path": "/storage/v1/bucket/notes/empty",
      "key": "service",
      "writes": true
    },
    {
      "name": "emptying a bucket that is not there",
      "feature": "bucket.empty",
      "method": "POST",
      "path": "/storage/v1/bucket/nowhere/empty",
      "key": "service",
      "writes": true
    },
    {
      "name": "deleting a bucket with nothing in it",
      "feature": "bucket.delete",
      "method": "DELETE",
      "path": "/storage/v1/bucket/notes",
      "key": "service",
      "writes": true
    },
    {
      "name": "deleting a bucket that still has something in it",
      "feature": "bucket.delete",
      "method": "DELETE",
      "path": "/storage/v1/bucket/photos",
      "key": "service",
      "writes": true,
      "note": "the row in storage.objects is the whole point of the fixture having one"
    },
    {
      "name": "deleting a bucket that is not there",
      "feature": "bucket.delete",
      "method": "DELETE",
      "path": "/storage/v1/bucket/nowhere",
      "key": "service",
      "writes": true
    },
    {
      "name": "deleting a bucket with an anon key",
      "feature": "bucket.delete",
      "method": "DELETE",
      "path": "/storage/v1/bucket/notes",
      "key": "anon",
      "writes": true
    },
    {
      "name": "a small text file into a bucket",
      "feature": "object.upload",
      "method": "POST",
      "path": "/storage/v1/object/notes/hello.txt",
      "key": "service",
      "headers": {
        "content-type": "text/plain"
      },
      "body": "hello world",
      "note": "the whole chain below hangs off this one, which is why it is first and why the ones under it say chained",
      "writes": true,
      "volatile": [
        "/Id"
      ]
    },
    {
      "name": "the file that was just uploaded",
      "feature": "object.download",
      "path": "/storage/v1/object/notes/hello.txt",
      "key": "service"
    },
    {
      "name": "the same file over the route that names the audience",
      "feature": "object.download",
      "path": "/storage/v1/object/authenticated/notes/hello.txt",
      "key": "service"
    },
    {
      "name": "the same file from a public bucket with no key at all",
      "feature": "object.download",
      "path": "/storage/v1/object/public/notes/hello.txt",
      "key": "none"
    },
    {
      "name": "the first four bytes of it",
      "feature": "object.download",
      "path": "/storage/v1/object/public/notes/hello.txt",
      "key": "none",
      "headers": {
        "range": "bytes=0-3"
      },
      "note": "a range request is the one download detail a client library depends on and nobody reads the spec for"
    },
    {
      "name": "the head of it",
      "feature": "object.download",
      "method": "HEAD",
      "path": "/storage/v1/object/notes/hello.txt",
      "key": "service"
    },
    {
      "name": "what is known about it",
      "feature": "object.info",
      "path": "/storage/v1/object/info/notes/hello.txt",
      "key": "service",
      "volatile": [
        "/id",
        "/created_at",
        "/last_modified",
        "/version"
      ]
    },
    {
      "name": "the same, over the public route",
      "feature": "object.info",
      "path": "/storage/v1/object/info/public/notes/hello.txt",
      "key": "none",
      "volatile": [
        "/id",
        "/created_at",
        "/last_modified",
        "/version"
      ]
    },
    {
      "name": "an object that is not there",
      "feature": "object.download",
      "path": "/storage/v1/object/notes/missing.txt",
      "key": "service"
    },
    {
      "name": "a private bucket over the public route",
      "feature": "object.download",
      "path": "/storage/v1/object/public/photos/nothing.txt",
      "key": "none",
      "note": "photos is not public, so this is refused before anything is looked for"
    },
    {
      "name": "a private bucket with an anon key",
      "feature": "object.download",
      "path": "/storage/v1/object/photos/holiday/beach.txt",
      "key": "anon",
      "note": "no policy on storage.objects in a project that has changed nothing, so the row is not visible and the bytes are never reached"
    },
    {
      "name": "a download with no key at all",
      "feature": "object.download",
      "path": "/storage/v1/object/notes/hello.txt",
      "key": "none"
    },
    {
      "name": "a private bucket with no key at all",
      "feature": "object.download",
      "path": "/storage/v1/object/photos/holiday/beach.txt",
      "key": "none",
      "note": "the pair of the public one above: the same route, the same absence of a token, and a bucket that is not public"
    },
    {
      "name": "the head of one that is not there",
      "feature": "object.download",
      "method": "HEAD",
      "path": "/storage/v1/object/notes/missing.txt",
      "key": "service",
      "note": "a head has no body to carry the refusal in, so the status is the whole answer"
    },
    {
      "name": "the same path uploaded again",
      "feature": "object.upload",
      "method": "POST",
      "path": "/storage/v1/object/notes/hello.txt",
      "key": "service",
      "headers": {
        "content-type": "text/plain"
      },
      "body": "hello again",
      "writes": true,
      "chained": true,
      "volatile": [
        "/Id"
      ]
    },
    {
      "name": "the same path uploaded again, asking to replace it",
      "feature": "object.upload",
      "method": "POST",
      "path": "/storage/v1/object/notes/hello.txt",
      "key": "service",
      "headers": {
        "content-type": "text/plain",
        "x-upsert": "true"
      },
      "body": "hello again",
      "writes": true,
      "chained": true,
      "volatile": [
        "/Id"
      ]
    },
    {
      "name": "the replacement, read back",
      "feature": "object.download",
      "path": "/storage/v1/object/notes/hello.txt",
      "key": "service"
    },
    {
      "name": "a put over the same path",
      "feature": "object.upload",
      "method": "PUT",
      "path": "/storage/v1/object/notes/hello.txt",
      "key": "service",
      "headers": {
        "content-type": "text/plain"
      },
      "body": "hello a third time",
      "note": "put is the update, so it wants the object to be there rather than not to be",
      "writes": true,
      "chained": true,
      "volatile": [
        "/Id"
      ]
    },
    {
      "name": "a multipart form, the way a browser sends one",
      "feature": "object.upload",
      "method": "POST",
      "path": "/storage/v1/object/notes/form.txt",
      "key": "service",
      "headers": {
        "content-type": "multipart/form-data; boundary=zouconformanceboundary"
      },
      "body": "--zouconformanceboundary\r\nContent-Disposition: form-data; name=\"cacheControl\"\r\n\r\n3600\r\n--zouconformanceboundary\r\nContent-Disposition: form-data; name=\"\"; filename=\"form.txt\"\r\nContent-Type: text/plain\r\n\r\nsent as a form\r\n--zouconformanceboundary--\r\n",
      "writes": true,
      "volatile": [
        "/Id"
      ]
    },
    {
      "name": "what the form upload left",
      "feature": "object.download",
      "path": "/storage/v1/object/notes/form.txt",
      "key": "service"
    },
    {
      "name": "a file into a bucket that is not there",
      "feature": "object.upload",
      "method": "POST",
      "path": "/storage/v1/object/nowhere/hello.txt",
      "key": "service",
      "headers": {
        "content-type": "text/plain"
      },
      "body": "hello world",
      "writes": true
    },
    {
      "name": "a file uploaded with an anon key",
      "feature": "object.upload",
      "method": "POST",
      "path": "/storage/v1/object/notes/anon.txt",
      "key": "anon",
      "headers": {
        "content-type": "text/plain"
      },
      "body": "hello world",
      "writes": true
    },
