    {
      "name": "everything a bucket holds",
      "feature": "object.list",
      "method": "POST",
      "path": "/storage/v1/object/list/photos",
      "key": "service",
      "headers": {
        "content-type": "application/json"
      },
      "body": "{\"prefix\":\"\",\"limit\":100,\"offset\":0,\"sortBy\":{\"column\":\"name\",\"order\":\"asc\"}}",
      "note": "the body a client library sends when it is asked for a listing and told nothing else"
    },
    {
      "name": "what is under a folder",
      "feature": "object.list",
      "method": "POST",
      "path": "/storage/v1/object/list/photos",
      "key": "service",
      "headers": {
        "content-type": "application/json"
      },
      "body": "{\"prefix\":\"holiday\",\"limit\":100,\"offset\":0,\"sortBy\":{\"column\":\"name\",\"order\":\"asc\"}}",
      "note": "a folder is not a row anywhere, it is the part of a name before a slash, so this is the question that says what one is"
    },
    {
      "name": "the same list the other way up",
      "feature": "object.list",
      "method": "POST",
      "path": "/storage/v1/object/list/photos",
      "key": "service",
      "headers": {
        "content-type": "application/json"
      },
      "body": "{\"prefix\":\"\",\"limit\":100,\"offset\":0,\"sortBy\":{\"column\":\"name\",\"order\":\"desc\"}}"
    },
    {
      "name": "a listing sorted by when the rows were made",
      "feature": "object.list",
      "method": "POST",
      "path": "/storage/v1/object/list/photos",
      "key": "service",
      "headers": {
        "content-type": "application/json"
      },
      "body": "{\"prefix\":\"\",\"limit\":100,\"offset\":0,\"sortBy\":{\"column\":\"created_at\",\"order\":\"asc\"}}",
      "note": "the fixture writes the timestamps in a different order from the names, so a sort that was ignored would look like a sort that worked"
    },
    {
      "name": "one row at a time, starting at the second",
      "feature": "object.list",
      "method": "POST",
      "path": "/storage/v1/object/list/photos",
      "key": "service",
      "headers": {
        "content-type": "application/json"
      },
      "body": "{\"prefix\":\"\",\"limit\":1,\"offset\":1,\"sortBy\":{\"column\":\"name\",\"order\":\"asc\"}}"
    },
    {
      "name": "a search for part of a name",
      "feature": "object.list",
      "method": "POST",
      "path": "/storage/v1/object/list/photos",
      "key": "service",
      "headers": {
        "content-type": "application/json"
      },
      "body": "{\"prefix\":\"\",\"limit\":100,\"offset\":0,\"search\":\"zeb\",\"sortBy\":{\"column\":\"name\",\"order\":\"asc\"}}"
    },
    {
      "name": "a prefix nothing is under",
      "feature": "object.list",
      "method": "POST",
      "path": "/storage/v1/object/list/photos",
      "key": "service",
      "headers": {
        "content-type": "application/json"
      },
      "body": "{\"prefix\":\"nowhere\",\"limit\":100,\"offset\":0,\"sortBy\":{\"column\":\"name\",\"order\":\"asc\"}}"
    },
    {
      "name": "a bucket that is not there",
      "feature": "object.list",
      "method": "POST",
      "path": "/storage/v1/object/list/nowhere",
      "key": "service",
      "headers": {
        "content-type": "application/json"
      },
      "body": "{\"prefix\":\"\",\"limit\":100,\"offset\":0,\"sortBy\":{\"column\":\"name\",\"order\":\"asc\"}}"
    },
    {
      "name": "a private bucket with an anon key",
      "feature": "object.list",
      "method": "POST",
      "path": "/storage/v1/object/list/photos",
      "key": "anon",
      "headers": {
        "content-type": "application/json"
