      "name": "a file uploaded with no key at all",
      "feature": "object.upload",
      "method": "POST",
      "path": "/storage/v1/object/notes/none.txt",
      "key": "none",
      "headers": {
        "content-type": "text/plain"
      },
      "body": "hello world",
      "writes": true
    },
    {
      "name": "a put where nothing is there yet",
      "feature": "object.upload",
      "method": "PUT",
      "path": "/storage/v1/object/notes/never.txt",
      "key": "service",
      "headers": {
        "content-type": "text/plain"
      },
      "body": "hello world",
      "writes": true,
      "volatile": [
        "/Id"
      ]
    },
    {
      "name": "removing the object the fixture wrote",
      "feature": "object.remove",
      "method": "DELETE",
      "path": "/storage/v1/object/photos/holiday/beach.txt",
      "key": "service",
      "note": "the row is in the fixture and the bytes are in no store, which is exactly the shape of an object whose upload half failed",
      "writes": true
    },
    {
