        "content-type": "application/json"
      },
      "body": "{\"id\":\"photos\",\"name\":\"photos\"}",
      "writes": true
    },
    {
      "name": "making a bucket with no id",
      "feature": "bucket.create",
      "method": "POST",
      "path": "/storage/v1/bucket",
      "key": "service",
