      "method": "PUT",
      "path": "/storage/v1/bucket/photos",
      "key": "service",
      "headers": {
        "content-type": "application/json"
      },
      "body": "{\"public\":true}",
      "writes": true
    },
    {
      "name": "putting a size limit on a bucket",
      "feature": "bucket.update",
      "method": "PUT",
      "path": "/storage/v1/bucket/notes",
      "key": "service",
      "headers": {
        "content-type": "application/json"
      },
      "body": "{\"public\":false,\"file_size_limit\":2048,\"allowed_mime_types\":[\"text/plain\"]}",
      "writes": true
