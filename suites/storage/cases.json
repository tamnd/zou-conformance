    {
      "name": "updating a bucket that is not there",
      "feature": "bucket.update",
      "method": "PUT",
      "path": "/storage/v1/bucket/nowhere",
      "key": "service",
      "headers": {
        "content-type": "application/json"
      },
      "body": "{\"public\":true}",
      "writes": true
    },
    {
      "name": "updating a bucket with an anon key",
      "feature": "bucket.update",
      "method": "PUT",
      "path": "/storage/v1/bucket/photos",
      "key": "anon",
