        "content-type": "application/json"
      },
      "body": "{\"name\":\"nameless\"}",
      "writes": true
    },
    {
      "name": "making a bucket out of something that is not json",
      "feature": "bucket.create",
      "method": "POST",
      "path": "/storage/v1/bucket",
      "key": "service",
      "headers": {
        "content-type": "application/json"
      },
      "body": "{",
      "writes": true
    },
    {
      "name": "making a bucket with an anon key",
      "feature": "bucket.create",
      "method": "POST",
      "path": "/storage/v1/bucket",
      "key": "anon",
      "headers": {
        "content-type": "application/json"
      },
      "body": "{\"id\":\"uninvited\",\"name\":\"uninvited\"}",
